# Google Sheet ID (from the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
# The sheet must be shared as "Anyone with the link can view".
# Leave empty to run in demo mode with bundled sample data.
VITE_GOOGLE_SHEET_ID=

# Base path for deployment.
# GitHub Pages project site: "/your-repo-name/"  |  Custom domain / user site: "/"
VITE_BASE_PATH=/

# Public site URL (used for canonical URLs, Open Graph, sitemap)
VITE_SITE_URL=https://yourusername.github.io/ccs-website
